# Copy to .env.local and fill in. Never commit real values.

# Supabase Postgres (dashboard > Connect > ORMs > Prisma)
DATABASE_URL=   # transaction pooler, port 6543, add ?pgbouncer=true
DIRECT_URL=     # direct / session connection, port 5432 (migrations)

# Auth (Better Auth). Generate a secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public site URL (metadata and absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First admin login for `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Later milestones
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RESEND_API_KEY=
DVLA_API_KEY=
