# Copy to .env.local and fill in. Never commit real values.

# Supabase Postgres (dashboard > Connect). Vercel needs the IPv4-compatible pooler.
# DATABASE_URL: transaction pooler on port 6543 (runtime)
# DIRECT_URL: session pooler on port 5432 (migrations; despite the variable name)
# Copy the exact project pooler hostname and URL-encode any password special characters.
# Never use localhost / 127.0.0.1 or the local development DB credentials on Vercel.
DATABASE_URL=
DIRECT_URL=

# Auth (Better Auth). Generate a secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public site URL (metadata and absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First admin login for `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Private customer photos attached to valuation enquiries (server-only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LEAD_PHOTO_BUCKET=gearup-enquiries
# Optional management token for setup tools only; never expose it to the browser.
SUPABASE_ACCESS_TOKEN=

# Later milestones
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RESEND_API_KEY=            # emails are skipped (and logged) until this is set
MAIL_FROM=                 # e.g. GearUp Motorcycles <hello@gearupmotorcycles.co.uk> (domain verified in Resend)
STAFF_NOTIFY_EMAIL=        # where new-enquiry alerts go (default sales@gearupmotorcycles.co.uk)
DVLA_API_KEY=
